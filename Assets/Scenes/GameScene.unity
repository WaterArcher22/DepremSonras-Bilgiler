  m_Script: {fileID: 11500000, guid: d8108d1764793824c918aedf05dc598e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  root: {fileID: 1945543997}
  messageText: {fileID: 559487672}
  continueButton: {fileID: 543258653}
  continueLabel: {fileID: 2130318886}
  skipButton: {fileID: 21657320}
  stepText: {fileID: 434028916}
  dimOverlay: {fileID: 856188059}
  dimAlpha: 0.65
  stepDimAlpha: 0
  dimFadeTime: 0.25
  newsReadTime: 0.785
  popTime: 0.15
  popStartScale: 0.85
  onlyFirstTime: 0
  delayAfterDecision: 2.5
  pulseColor: {r: 1, g: 0.85, b: 0.3, a: 1}
  pulseScale: 1.1
  pulseSpeed: 2
  closeButtonColorPulse: 0
  introPages:
  - "Afetlerden sonra yaln\u0131zca binalar de\u011Fil, bilgi de y\u0131k\u0131l\u0131r.\nDo\u011Frulanmam\u0131\u015F
    tek bir payla\u015F\u0131m; pani\u011Fe, yanl\u0131\u015F yere giden yard\u0131ma
    ve kaybedilen zamana yol a\xE7abilir."
  - "Bu oyunda bir kriz ileti\u015Fim merkezindesin.\nG\xF6revin, halka yaln\u0131zca
    DO\u011ERULANMI\u015E bilgiyi ula\u015Ft\u0131rmak."
  welcomeText: "TV'ye gelen her haberi masandaki bilgilerle do\u011Frula:\ndo\u011Fruysa
    PAYLA\u015E, yanl\u0131\u015Fsa S\u0130L"
  laptopOpenText: "Bu haber bir YOLDAN bahsediyor.\nYollar\u0131n durumunu yan\u0131p
    s\xF6nen LAPTOPTAN kontrol et."
  laptopDecideText: "\xDCnlem = Kapal\u0131\nPencereyi kapat ve karar\u0131n\u0131
    ver: PAYLA\u015E ya da S\u0130L."
  mapOpenText: "Su, yemek ve \xE7ad\u0131r da\u011F\u0131t\u0131mlar\u0131 HAR\u0130TADA
    g\xF6r\xFCn\xFCr.\nYan\u0131p s\xF6nen haritay\u0131 a\xE7, haberdeki b\xF6lgeye
    bak."
  mapDecideText: "B\xF6lgenin \xFCst\xFCnde ilgili i\u015Faret var m\u0131?\nPencereyi
    kapat ve karar\u0131n\u0131 ver."
  reportOpenText: "Kurtarma ve itfaiye ekiplerinin nerede \xE7al\u0131\u015Ft\u0131\u011F\u0131
    G\xD6REVLEND\u0130RME C\u0130HAZINDA yazar.\nYan\u0131p s\xF6nen cihaz\u0131
    a\xE7."
  reportDecideText: "Ekip bu b\xF6lgede \xE7al\u0131\u015F\u0131yor mu?\nPencereyi
    kapat ve karar\u0131n\u0131 ver."
  chooseText: "\u015Eimdi karar\u0131n\u0131 ver:\nhaber do\u011Fruysa PAYLA\u015E,
    yanl\u0131\u015Fsa S\u0130L."
  knowledgeText: "Baz\u0131 haberler masaya bakmadan \xE7\xF6z\xFCl\xFCr.\nHABER\u0130N
    KAYNA\u011EINA ve i\xE7eri\u011Fine dikkat et: depremler \xF6nceden tahmin edilebilir
    mi?"
  finalText: "Bilgiler oyun boyunca DE\u011E\u0130\u015E\u0130R; de\u011Fi\u015Fen
    cihaz turuncu yan\u0131p s\xF6ner.\nHer haberin bir s\xFCresi var. Bazen odaya
    biri gelip soru sorar; cevab\u0131 yine masada. DO\u011ERULUK BARI biterse oyun
    biter. Haz\u0131r m\u0131s\u0131n?"
